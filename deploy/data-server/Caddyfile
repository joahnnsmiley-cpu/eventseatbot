# TLS terminator in front of PostgREST and Storage.
#
# supabase clients call /rest/v1/<table> and /storage/v1/<...>, while PostgREST
# and Storage serve from the root. handle_path strips the prefix, so the
# existing client code works untouched.
#
# TLS is not decoration here: the service_role key travels in these requests
# and it bypasses RLS.
#
# A host that is not set yet falls back to *.localhost, which Caddy serves with
# its internal CA instead of asking Let's Encrypt for a certificate.

(rest) {
	handle_path /rest/v1/* {
		reverse_proxy {args[0]}:3000
	}
}

{$LEELAH_HOST:leelah.localhost} {
	import rest rest-leelah
	handle {
		respond 404
	}
}

{$MURASHKI_HOST:murashki.localhost} {
	import rest rest-murashki
	handle {
		respond 404
	}
}

{$TICKETS_HOST:tickets.localhost} {
	import rest rest-tickets
	handle_path /storage/v1/* {
		reverse_proxy storage-tickets:5000
	}
	# Nothing else is served. A stray request gets a flat 404.
	handle {
		respond 404
	}
}
